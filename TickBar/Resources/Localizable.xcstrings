    "dataSource.extended.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "US extended-session sources" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "美股扩展时段数据源" } }
      }
    },
    "dataSource.extended.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Independent from regular-session sources. Tried in priority order for each missing symbol. Enabled does not guarantee live overnight coverage; stale or untimestamped trades are rejected. Results below describe the last request, not a guarantee of real-time data." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "独立于常规盘数据源，按优先级逐标的补齐。启用不保证夜盘覆盖；旧时段或无成交时间的报价不会采用。下方为最近一次请求结果，不表示实时性保证。" } }
      }
    },
    "dataSource.extended.nightCandidate": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pre / Post / overnight candidate" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "盘前 / 盘后 / 夜盘候选" } }
      }
    },
