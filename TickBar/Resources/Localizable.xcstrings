{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "volume.source.eastMoney": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "东方财富" } }, "en": { "stringUnit": { "state": "translated", "value": "East Money" } } } },
    "volume.source.tencent": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "腾讯" } }, "en": { "stringUnit": { "state": "translated", "value": "Tencent" } } } },
    "volume.sources": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "明细：%@ · 分时：%@" } }, "en": { "stringUnit": { "state": "translated", "value": "Trades: %@ · Minutes: %@" } } } },
    "volume.dateMismatch": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "成交明细与分时的交易日期不一致，未合并数据，请稍后刷新" } }, "en": { "stringUnit": { "state": "translated", "value": "Trade and minute dates differ. Data was not combined; please refresh later." } } } },
    "volume.netChart": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "净买 / 净卖" } }, "en": { "stringUnit": { "state": "translated", "value": "Net buy / sell" } } } },
    "volume.netBuy": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "净买（上方）" } }, "en": { "stringUnit": { "state": "translated", "value": "Net buy (above)" } } } },
    "volume.netSell": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "净卖（下方）" } }, "en": { "stringUnit": { "state": "translated", "value": "Net sell (below)" } } } },
    "volume.netMissing": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "净额缺失" } }, "en": { "stringUnit": { "state": "translated", "value": "Net unavailable" } } } },
    "volume.unitAmount": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "万元" } }, "en": { "stringUnit": { "state": "translated", "value": "CNY 10,000" } } } },
    "volume.netHint": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "大、中、小额分别计算净额（主动买入估额 − 主动卖出估额，万元）；净买向上、净卖向下分别堆叠。中性成交不计入，缺失分钟以灰纹标记。" } }, "en": { "stringUnit": { "state": "translated", "value": "Net is buys − sells per large, medium and small category (CNY 10,000). Net buys stack above zero; net sells below. Neutral trades are excluded; gray hatching marks unavailable minutes." } } } },
    "volume.netTable": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "分钟分类净额表（万元）" } }, "en": { "stringUnit": { "state": "translated", "value": "Minute net by category (CNY 10,000)" } } } },
    "volume.title": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "成交量分析" } }, "en": { "stringUnit": { "state": "translated", "value": "Volume analysis" } } } },
    "volume.band.0": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "大额明细" } }, "en": { "stringUnit": { "state": "translated", "value": "Large records" } } } },
    "volume.band.1": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "中额明细" } }, "en": { "stringUnit": { "state": "translated", "value": "Medium records" } } } },
    "volume.band.2": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "小额明细" } }, "en": { "stringUnit": { "state": "translated", "value": "Small records" } } } },
    "volume.threshold.0": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "估算金额 ≥ 100 万元" } }, "en": { "stringUnit": { "state": "translated", "value": "Estimated ≥ CNY 1M" } } } },
    "volume.threshold.1": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "10 万 ≤ 估额 < 100 万元" } }, "en": { "stringUnit": { "state": "translated", "value": "CNY 100K ≤ est. < 1M" } } } },
    "volume.threshold.2": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "估算金额 < 10 万元" } }, "en": { "stringUnit": { "state": "translated", "value": "Estimated < CNY 100K" } } } },
    "volume.unsupported": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "目前支持沪深 A 股个股" } }, "en": { "stringUnit": { "state": "translated", "value": "Available for Shanghai and Shenzhen A-share stocks" } } } },
    "volume.invalidResponse": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "成交数据响应无效，请稍后重试" } }, "en": { "stringUnit": { "state": "translated", "value": "Invalid trade data response. Please retry later." } } } },
    "volume.noTrades": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "暂无可对账的已完成分钟成交数据" } }, "en": { "stringUnit": { "state": "translated", "value": "No completed trade minutes available for reconciliation" } } } },
    "volume.loading": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在获取并核对成交数据…" } }, "en": { "stringUnit": { "state": "translated", "value": "Loading and reconciling trade data…" } } } },
    "volume.method": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "按单条公开明细金额分档：东方财富金额按价格 × 手数 × 100 股估算；腾讯采用接口成交额。明细可能合并多笔成交，买卖方向采用各源标记，不代表原始委托大小或投资者身份。仅对已完成且成交量完全对账的分钟分类，其余未分类，不填造历史。金额单位为万元人民币。" } }, "en": { "stringUnit": { "state": "translated", "value": "Records are grouped by amount: East Money estimates price × lots × 100 shares; Tencent supplies turnover. Records may combine executions and each source assigns direction differently; neither identifies original orders or investors. Only completed, exactly reconciled minutes are classified; other volume stays unknown. No synthetic history. Amounts are in CNY 10,000." } } } },
    "volume.resume": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "继续" } }, "en": { "stringUnit": { "state": "translated", "value": "Resume" } } } },
    "volume.pause": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "暂停" } }, "en": { "stringUnit": { "state": "translated", "value": "Pause" } } } },
    "volume.refresh": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "刷新" } }, "en": { "stringUnit": { "state": "translated", "value": "Refresh" } } } },
    "volume.total": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "截至所示分钟的累计成交量" } }, "en": { "stringUnit": { "state": "translated", "value": "Volume through the displayed minute" } } } },
    "volume.through": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "截至" } }, "en": { "stringUnit": { "state": "translated", "value": "Through" } } } },
    "volume.coverage": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "分类覆盖率 %.1f%%" } }, "en": { "stringUnit": { "state": "translated", "value": "Classified volume %.1f%%" } } } },
    "volume.gaps": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "部分分钟明细缺失或量不一致，已保留为未分类" } }, "en": { "stringUnit": { "state": "translated", "value": "Missing or inconsistent minutes are shown as unclassified" } } } },
    "volume.chart": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "图表" } }, "en": { "stringUnit": { "state": "translated", "value": "Chart" } } } },
    "volume.classified": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "分类成交量" } }, "en": { "stringUnit": { "state": "translated", "value": "Classified volume" } } } },
    "volume.totalChart": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "总成交量" } }, "en": { "stringUnit": { "state": "translated", "value": "Total volume" } } } },
    "volume.texture": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "图纹" } }, "en": { "stringUnit": { "state": "translated", "value": "Patterns" } } } },
    "volume.unknown": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "未分类" } }, "en": { "stringUnit": { "state": "translated", "value": "Unclassified" } } } },
    "volume.unitHands": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "成交量（手）" } }, "en": { "stringUnit": { "state": "translated", "value": "Volume (lots)" } } } },
    "volume.hands": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "手" } }, "en": { "stringUnit": { "state": "translated", "value": "lots" } } } },
    "volume.hover": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "悬停查看每分钟成交量，或展开下方数据表" } }, "en": { "stringUnit": { "state": "translated", "value": "Hover to inspect a minute, or expand the data table below" } } } },
    "volume.summary": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "分类统计 · 金额为估算值，单位万元" } }, "en": { "stringUnit": { "state": "translated", "value": "Classification · estimated amounts in CNY 10,000" } } } },
    "volume.band": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "明细量级" } }, "en": { "stringUnit": { "state": "translated", "value": "Record size" } } } },
    "volume.buy": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "主动买入" } }, "en": { "stringUnit": { "state": "translated", "value": "Buy" } } } },
    "volume.sell": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "主动卖出" } }, "en": { "stringUnit": { "state": "translated", "value": "Sell" } } } },
    "volume.neutral": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "中性" } }, "en": { "stringUnit": { "state": "translated", "value": "Neutral" } } } },
    "volume.net": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "买卖净额" } }, "en": { "stringUnit": { "state": "translated", "value": "Net" } } } },
    "volume.minuteTable": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "分钟数据表（手）" } }, "en": { "stringUnit": { "state": "translated", "value": "Minute data table (lots)" } } } },
    "volume.time": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "时间" } }, "en": { "stringUnit": { "state": "translated", "value": "Time" } } } },
    "volume.keptPrevious": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "更新失败，保留上次数据。" } }, "en": { "stringUnit": { "state": "translated", "value": "Update failed; previous data retained." } } } },
    "volume.paused": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "自动刷新已暂停，可手动刷新" } }, "en": { "stringUnit": { "state": "translated", "value": "Automatic updates paused; manual refresh is available" } } } },
    "volume.source": { "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "可见且开市时每 60 秒刷新" } }, "en": { "stringUnit": { "state": "translated", "value": "Updates every 60s while visible and trading" } } } },
